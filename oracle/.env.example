# Copy thành file .env (cùng thư mục) rồi điền giá trị sau dấu =
#   cp .env.example .env && nano .env
# File .env là BÍ MẬT — đã nằm trong .gitignore, KHÔNG commit.
# Ý nghĩa từng key: xem RAILWAY-VARIABLES.md (giống hệt Railway).

# ===== BẮT BUỘC =====
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# ===== TUỲ CHỌN (để TRỐNG nếu chưa dùng) =====
COACHIO_API_KEY=
JINA_API_KEY=
APIFY_TOKEN=
GROQ_API_KEY=

# ===== ĐỔI BỘ NÃO (để TRỐNG = Gemini mặc định) =====
AI_MODEL=
AI_FALLBACKS=
DEEPSEEK_API_KEY=
